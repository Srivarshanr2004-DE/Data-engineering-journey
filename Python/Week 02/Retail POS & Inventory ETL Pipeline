import pandas as pd

# Load the raw data
sales = pd.read_csv('data/raw/raw_sales.csv')
inventory = pd.read_json('data/raw/product_master.json')

# --- Clean Sales Data ---
# Remove any accidental duplicate rows
sales = sales.drop_duplicates()

# Fill missing customers with a default value
sales['customer_id'] = sales['customer_id'].fillna('GUEST')

# Keep only valid quantities (drop nulls and negatives)
sales = sales.dropna(subset=['quantity'])
sales = sales[sales['quantity'] > 0]

# Standardize dates
sales['transaction_date'] = pd.to_datetime(sales['transaction_date'])

# --- Clean Inventory Data ---
# Clean up whitespace and capitalize categories properly
inventory['category'] = inventory['category'].str.strip().str.title()

# --- Merge and Calculate ---
# Join the tables on product_id
df = pd.merge(sales, inventory, on='product_id', how='inner')

# Calculate revenue per transaction
df['total_revenue'] = df['quantity'] * df['price']

# --- Grouping & Filtering ---
# Find total revenue per category per day
daily_revenue = df.groupby(['transaction_date', 'category'])['total_revenue'].sum().reset_index()

# Find items that need to be restocked
low_stock = inventory[inventory['current_stock'] < inventory['min_stock']]

# --- Export ---
# Save the final cleaned tables
daily_revenue.to_csv('data/processed/daily_revenue.csv', index=False)
low_stock.to_csv('data/processed/low_stock_alerts.csv', index=False)

print("Data processing finished. Files saved to processed folder.")
